@article{brustLDL^textrmTTrustRegionQuasiNewton2024,
  title = {An \textbackslash (\textbraceleft{{LDL}}\textbraceright\textasciicircum\textbraceleft\textbackslash textrm\textbraceleft{{T}}\textbraceright\textbraceright\textbackslash ) {{Trust-Region Quasi-Newton Method}}},
  author = {Brust, Johannes J. and Gill, Philip E.},
