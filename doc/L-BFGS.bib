@misc{wangConvergenceRatesRegularized2025,
  title = {Convergence Rates of Regularized Quasi-{{Newton}} Methods without Strong Convexity},
  author = {Wang, Shida and Fadili, Jalal and Ochs, Peter},
  year = 2025,
  month = jun,
  number = {arXiv:2506.00521},
  eprint = {2506.00521},
  primaryclass = {math},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2506.00521},
  urldate = {2025-06-07},
  abstract = {In this paper, we study convergence rates of the cubic regularized proximal quasi-Newton method (\textbackslash csr) for solving non-smooth additive composite problems that satisfy the so-called Kurdyka-\textbackslash L ojasiewicz (K\textbackslash L ) property with respect to some desingularization function \$\textbackslash phi\$ rather than strong convexity. After a number of iterations \$k\_0\$, Cubic SR1 PQN exhibits non-asymptotic explicit super-linear convergence rates for any \$k\textbackslash geq k\_0\$. In particular, when \$\textbackslash phi(t)=ct\textasciicircum\textbraceleft 1/2\textbraceright\$, Cubic SR1 PQN has a convergence rate of order \$\textbackslash left(\textbackslash frac\textbraceleft C\textbraceright\textbraceleft (k-k\_0)\textasciicircum\textbraceleft 1/2\textbraceright\textbraceright\textbackslash right)\textasciicircum\textbraceleft (k-k\_0)/2\textbraceright\$, where \$k\$ is the number of iterations and \$C{$>$}0\$ is a constant. For the special case, i.e. functions which satisfy \textbackslash L ojasiewicz inequality, the rate becomes global and non-asymptotic. This work presents, for the first time, non-asymptotic explicit convergence rates of regularized (proximal) SR1 quasi-Newton methods applied to non-convex non-smooth problems with K\textbackslash L\textbackslash{} property. Actually, the rates are novel even in the smooth non-convex case. Notably, we achieve this without employing line search or trust region strategies, without assuming the Dennis-Mor\textbackslash 'e condition, without any assumptions on quasi-Newton metrics and without assuming strong convexity. Furthermore, for convex problems, we focus on a more tractable gradient regularized quasi-Newton method (Grad SR1 PQN) which can achieve results similar to those obtained with cubic regularization. We also demonstrate, for the first time, the non-asymptotic super-linear convergence rate of Grad SR1 PQN for solving convex problems with the help of the \textbackslash L ojasiewicz inequality instead of strong convexity.},
  archiveprefix = {arXiv},
  keywords = {Mathematics - Optimization and Control},
  file = {C\:\\Users\\hirok\\Zotero\\storage\\IWIXBJCW\\Wang et al. - 2025 - Convergence rates of regularized quasi-Newton methods without strong convexity.pdf;C\:\\Users\\hirok\\Zotero\\storage\\Q5PR4H3W\\2506.html}
}

@article{wardAdaGradStepsizesSharp2020,
  title = {{{AdaGrad}} Stepsizes: Sharp Convergence over Nonconvex Landscapes},
  shorttitle = {{{AdaGrad}} Stepsizes},
  author = {Ward, Rachel and Wu, Xiaoxia and Bottou, L{\'e}on},
  year = 2020,
  journal = {J. Mach. Learn. Res.},
  volume = {21},
  number = {1},
  pages = {219:9047--219:9076},
  issn = {1532-4435},
  abstract = {Adaptive gradient methods such as AdaGrad and its variants update the stepsize in stochastic gradient descent on the fly according to the gradients received along the way; such methods have gained widespread use in large-scale optimization for their ability to converge robustly, without the need to fine-tune the stepsize schedule. Yet, the theoretical guarantees to date for AdaGrad are for online and convex optimization. We bridge this gap by providing theoretical guarantees for the convergence of AdaGrad for smooth, nonconvex functions. We show that the norm version of AdaGrad (AdaGrad-Norm) converges to a stationary point at the O(log(N)/\textsurd N) rate in the stochastic setting, and at the optimal O(1/N) rate in the batch (non-stochastic) setting - in this sense, our convergence guarantees are "sharp". In particular, the convergence of AdaGrad-Norm is robust to the choice of all hyperparameters of the algorithm, in contrast to stochastic gradient descent whose convergence depends crucially on tuning the step-size to the (generally unknown) Lipschitz smoothness constant and level of stochastic noise on the gradient. Extensive numerical experiments are provided to corroborate our theoretical findings; moreover, the experiments suggest that the robustness of AdaGrad-Norm extends to the models in deep learning.},
  file = {C:\Users\hirok\Zotero\storage\9572ZKPC\Ward et al. - 2020 - AdaGrad stepsizes sharp convergence over nonconvex landscapes.pdf}
}

